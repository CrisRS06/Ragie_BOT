# Base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/inventario_peps?schema=public"

# Autenticación
JWT_SECRET="cambiar_en_produccion_generar_secreto_fuerte"
JWT_EXPIRES_IN="7d"
NEXTAUTH_SECRET="cambiar_en_produccion_generar_secreto_fuerte"
NEXTAUTH_URL="http://localhost:3000"

# Supabase (opcional, si se usa)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Email (para notificaciones)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="notificaciones@example.com"
SMTP_PASSWORD=""
EMAIL_FROM="Sistema PEPS <notificaciones@example.com>"

# Configuración del sistema
NEXT_PUBLIC_APP_NAME="Sistema de Inventario PEPS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
FISCALIZADOR_EMAIL="fiscalizador@pani.go.cr"

# Almacenamiento
STORAGE_PATH="./storage"
MAX_FILE_SIZE="10485760"

# Cron jobs (para ambientes específicos)
ENABLE_CRON_JOBS="true"

# Modo desarrollo
NODE_ENV="development"
