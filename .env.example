# =====================================================
# RAILWAY DEPLOYMENT
# =====================================================
# Railway provee DATABASE_URL automáticamente al agregar PostgreSQL plugin.
# Solo necesitas configurar estas 3 variables manualmente en Railway:
#
# JWT_SECRET        → openssl rand -base64 32
# NEXTAUTH_SECRET   → openssl rand -base64 32
# NEXTAUTH_URL      → https://tu-app.up.railway.app
# =====================================================

# Base de datos (Railway lo provee automáticamente)
DATABASE_URL="postgresql://usuario:password@localhost:5432/inventario_peps?schema=public"

# Autenticación (REQUERIDO - generar secretos seguros)
JWT_SECRET="cambiar_en_produccion_generar_secreto_fuerte"
JWT_EXPIRES_IN="7d"
NEXTAUTH_SECRET="cambiar_en_produccion_generar_secreto_fuerte"
NEXTAUTH_URL="http://localhost:3000"

# Email (para notificaciones)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="notificaciones@example.com"
SMTP_PASSWORD=""
EMAIL_FROM="Sistema PEPS <notificaciones@example.com>"

# Configuración del sistema
NEXT_PUBLIC_APP_NAME="Sistema de Inventario PEPS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
FISCALIZADOR_EMAIL="fiscalizador@pani.go.cr"

# Almacenamiento
STORAGE_PATH="./storage"
MAX_FILE_SIZE="10485760"

# Cron jobs (para ambientes específicos)
ENABLE_CRON_JOBS="true"

# Modo desarrollo
NODE_ENV="development"
